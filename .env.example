# KURO MANAGER Environment Variables

# Neon PostgreSQL connection string (Replace with your Neon database URL)
# Example: postgresql://neondb_owner:npg_password@ep-cold-star-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require"

# Better Auth Secret (Generate with: openssl rand -hex 32)
BETTER_AUTH_SECRET="your-32-char-random-secret"

# Better Auth URLs
BETTER_AUTH_URL="https://your-domain.vercel.app"
NEXT_PUBLIC_BETTER_AUTH_URL="https://your-domain.vercel.app"

# Initial Admin Credentials (used during db:seed)
ADMIN_INITIAL_EMAIL="admin@kuro.local"
ADMIN_INITIAL_PASSWORD="ChangeThisPassword123!"

# Optional: Shared Secret for EXE Client Authorization (leave empty to disable API key check)
KURO_CLIENT_API_KEY=""
